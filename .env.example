# Optional local configuration. Never commit .env or credentials.
NARYADAI_ENVIRONMENT=development
NARYADAI_LOG_LEVEL=INFO
NARYADAI_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
NARYADAI_CORS_ORIGINS=[]
# Supply your own DSN. scripts/dev_database.py start writes a private local .env
# when it does not already exist. No default database credentials.
# NARYADAI_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:55432/naryadai
NARYADAI_SESSION_TTL_SECONDS=28800
NARYADAI_LOGIN_WINDOW_SECONDS=900
NARYADAI_LOGIN_ACCOUNT_LIMIT=5
NARYADAI_LOGIN_PEER_LIMIT=50
# Private local photo volume; never expose it as static files.
NARYADAI_PHOTO_ROOT=var/photos
NARYADAI_PHOTO_MAX_BYTES=10485760
NARYADAI_PHOTO_MAX_PIXELS=24000000
NARYADAI_PHOTO_MAX_DIMENSION=2048
NARYADAI_PHOTO_OUTPUT_MAX_BYTES=2097152
# Seed only: choose a 6..128-character secret explicitly.
# NARYADAI_DEMO_SECRET=

# Independent worker; time intervals in minutes except explicitly named seconds.
NARYADAI_WORKER_INTERVAL_SECONDS=2
NARYADAI_REALTIME_POLL_SECONDS=1
NARYADAI_REMINDER_MINUTES=30
NARYADAI_ACCEPTANCE_MINUTES=10
NARYADAI_EMERGENCY_ACCEPTANCE_MINUTES=3
NARYADAI_OVERDUE_REPEAT_MINUTES=30
NARYADAI_MANAGER_ESCALATION_MINUTES=60
# Web Push is optional locally; generate a stable private key with scripts/dev_push.py.
# NARYADAI_WEB_PUSH_PRIVATE_KEY_FILE=var/webpush/vapid_private.pem
# NARYADAI_WEB_PUSH_SUBJECT=https://github.com/YOUR_TEAM/YOUR_REPOSITORY
NARYADAI_PUSH_TIMEOUT_SECONDS=10
NARYADAI_PUSH_MAX_ATTEMPTS=5
NARYADAI_PUSH_LEASE_SECONDS=60
# Real AI review. Missing key => transparent local checks + master's decision.
# Keep the actual key only in private .env; never paste it into issue reports.
# NARYADAI_AI_API_KEY=
NARYADAI_AI_MODEL=gpt-4.1-mini-2025-04-14
# Opt in only for equipment-only photos cleared for external processing.
# EXIF is stripped; faces, badges and visible personal data are NOT auto-anonymized.
NARYADAI_AI_VISION_ENABLED=false
NARYADAI_AI_TIMEOUT_SECONDS=30
NARYADAI_AI_TOTAL_TIMEOUT_SECONDS=45
NARYADAI_AI_MAX_ATTEMPTS=3
NARYADAI_AI_LEASE_SECONDS=120
