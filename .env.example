# Optional local configuration. Never commit .env or credentials.
NARYADAI_ENVIRONMENT=development
NARYADAI_LOG_LEVEL=INFO
NARYADAI_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
NARYADAI_CORS_ORIGINS=[]
# Supply your own DSN. scripts/dev_database.py start writes a private local .env
# when it does not already exist. No default database credentials.
# NARYADAI_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:55432/naryadai
NARYADAI_SESSION_TTL_SECONDS=28800
NARYADAI_LOGIN_WINDOW_SECONDS=900
NARYADAI_LOGIN_ACCOUNT_LIMIT=5
NARYADAI_LOGIN_PEER_LIMIT=50
# Private local photo volume; never expose it as static files.
NARYADAI_PHOTO_ROOT=var/photos
NARYADAI_PHOTO_MAX_BYTES=10485760
NARYADAI_PHOTO_MAX_PIXELS=24000000
NARYADAI_PHOTO_MAX_DIMENSION=2048
NARYADAI_PHOTO_OUTPUT_MAX_BYTES=2097152
# Seed only: choose a 6..128-character secret explicitly.
# NARYADAI_DEMO_SECRET=
