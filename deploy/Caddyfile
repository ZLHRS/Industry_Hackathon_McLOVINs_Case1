{
	admin off
}

{$NARYADAI_SITE_ADDRESS:http://:80} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}
	request_body {
		max_size 21MB
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000 {
			# Replace incoming forwarding headers; only this private proxy reaches API.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@worker path /sw.js /index.html / /manifest.webmanifest /orders /orders/* /reference /reference/* /workload /analytics /employees
		header @worker Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Unpublished listener for the Cloudflare connector only. The external hop is HTTPS.
http://:8081 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}
	request_body {
		max_size 21MB
	}
	@public host technaryad.online www.technaryad.online
	handle @public {
		@plainHttp header X-Forwarded-Proto http
		redir @plainHttp https://{host}{uri} 308
		@api path /api /api/*
		handle @api {
			reverse_proxy api:8000 {
				header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
				header_up X-Forwarded-Proto https
			}
		}
		handle {
			root * /srv
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			@worker path /sw.js /index.html / /manifest.webmanifest /orders /orders/* /reference /reference/* /workload /analytics /employees
			header @worker Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
	respond 404
}
